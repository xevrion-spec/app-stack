{
 "openapi": "3.0.1",
 "info": {
  "title": "GitHub",
  "version": "1.0.0"
 },
 "servers": [
  {
   "url": "https://api.github.com"
  }
 ],
 "components": {
  "securitySchemes": {
   "auth": {
    "type": "http",
    "scheme": "bearer"
   }
  }
 },
 "security": [
  {
   "auth": []
  }
 ],
 "paths": {
  "/repos/{owner}/{repo}": {
   "get": {
    "operationId": "getRepo",
    "summary": "Get repo",
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "parameters": [
     {
      "name": "owner",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "repo",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/repos/{owner}/{repo}/branches": {
   "get": {
    "operationId": "listBranches",
    "summary": "List branches",
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "parameters": [
     {
      "name": "owner",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "repo",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/repos/{owner}/{repo}/contents/{path}": {
   "get": {
    "operationId": "getContents",
    "summary": "Get file contents",
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "parameters": [
     {
      "name": "owner",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "repo",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "path",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "ref",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/repos/{owner}/{repo}/issues": {
   "get": {
    "operationId": "listIssues",
    "summary": "List issues",
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "parameters": [
     {
      "name": "owner",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "repo",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   },
   "post": {
    "operationId": "createIssue",
    "summary": "Create issue",
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "parameters": [
     {
      "name": "owner",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "repo",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "title": {
          "type": "string"
         },
         "body": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  },
  "/repos/{owner}/{repo}/pulls": {
   "get": {
    "operationId": "listPulls",
    "summary": "List PRs",
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "parameters": [
     {
      "name": "owner",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "repo",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "state",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  }
 }
}