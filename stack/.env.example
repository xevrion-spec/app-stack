# Xevrion app stack keys. Paste each key after the = sign. Never commit this file.
# Cloudflare: https://dash.cloudflare.com/profile/api-tokens  (Create Token)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# GitHub: https://github.com/settings/personal-access-tokens  (fine-grained, repo xevrion-spec/app-stack)
GITHUB_TOKEN=
# FreeLLMAPI (primary LLM for all apps, replaces Claude): key from your freellmapi account / local folder
FREELLMAPI_KEY=
FREELLMAPI_BASE_URL=
# Relume: Relume account settings (API / Figma integration)
RELUME_API_KEY=
# Bolt: bolt.new has no public API; exports go to GitHub instead
# Kapa: https://app.kapa.ai  -> project -> API keys
KAPA_API_KEY=
KAPA_PROJECT_ID=
# Loops: https://app.loops.so/settings?page=api
LOOPS_API_KEY=
# Webhook / Temporal: Temporal Cloud namespace + API key (leave blank if self-hosting)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Self-hosted (filled in by me after Docker install): Dify, Langfuse, Steel, Daytona, Postiz, Coolify
DIFY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
STEEL_API_URL=
DAYTONA_API_KEY=
POSTIZ_API_KEY=
COOLIFY_API_TOKEN=
DIFY_API_URL=
DAYTONA_API_URL=
POSTIZ_URL=
STEEL_UI_URL=
OPENAI_API_BASE=
OPENAI_API_KEY=
FREELLMAPI_MODEL=
BRIDGE_TOKEN=
CREWAI_PYTHON=
