{
  "ci": {
    "collect": {
      "staticDistDir": "apps/web/dist",
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 300000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse"
    }
  }
}