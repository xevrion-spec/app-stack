{
  "name": "@xevrion/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --root ../.. apps/api",
    "openapi": "tsx scripts/openapi.ts",
    "db:migrate:local": "wrangler d1 migrations apply autopilot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply autopilot-db --remote"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@xevrion/pipeline": "*",
    "@xevrion/platform": "*",
    "hono": "^4.13.13",
    "jose": "^5.10.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@hono/node-server": "^2.1.5",
    "@types/better-sqlite3": "^9.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "better-sqlite3": "^11.10.0",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
