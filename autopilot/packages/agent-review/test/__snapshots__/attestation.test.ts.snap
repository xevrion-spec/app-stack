exports[`control wording is stable (auditors diff packs) > snapshots every control in healthy, gap and empty states 1`] = `
[
  {
    "detail": "10 trails verified",
    "id": "record-keeping",
    "refs": [
      "EU AI Act Art. 12",
      "EU AI Act Art. 19",
      "NIST AI RMF MEASURE",
    ],
    "statement": "Every request has a tamper-evident, hash-chained event log",
    "status": "evidenced",
  },
  {
    "detail": "7 of 10 routed to people (8 decisions); 3 decided by policy",
    "id": "human-oversight",
    "refs": [
      "EU AI Act Art. 14",
      "NIST AI RMF MANAGE",
    ],
    "statement": "Agent actions are routed to people by versioned policy; critical risk is never auto-approved",
    "status": "evidenced",
  },
  {
    "detail": "retention 365 days; 1 on legal hold; 2 redacted",
    "id": "log-retention",
    "refs": [
      "EU AI Act Art. 26(6)",
      "UK GDPR Art. 5(1)(e)",
    ],
    "statement": "Logs are kept at least 183 days and then minimised",
    "status": "evidenced",
  },
  {
    "detail": "2 policy versions in force during the period",
    "id": "policy-governance",
    "refs": [
      "NIST AI RMF GOVERN",
    ],
    "statement": "Routing rules are immutable, versioned and hashed; every request records the version that routed it",
    "status": "evidenced",
  },
]
`;

